NODE_ENV=development
PORT=3003

# ── AI ────────────────────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ── Database (same instance as apps/backend) ──────────────────────────────────
DATABASE_URL=postgresql://...

# ── Redis (same instance as apps/backend) ────────────────────────────────────
REDIS_URL=rediss://...

# ── Network RPC URLs (server-side only — never sent to browser) ──────────────
ETHEREUM_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
ARBITRUM_SEPOLIA_RPC_URL=https://arb-sepolia.g.alchemy.com/v2/YOUR_KEY
POLYGON_AMOY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_KEY

# ── Bundler URLs (optional — only needed for UserOp submission) ───────────────
# ETHEREUM_SEPOLIA_BUNDLER_URL=https://api.pimlico.io/v2/11155111/rpc?apikey=...
# ARBITRUM_SEPOLIA_BUNDLER_URL=https://api.pimlico.io/v2/421614/rpc?apikey=...

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ── Global parameters ─────────────────────────────────────────────────────────
AGENT_MAX_TOOL_ITERATIONS=8
TRANSACTION_PROPOSAL_TTL_SECONDS=300
CHAINLINK_MAX_PRICE_AGE_SECONDS=3600
AAVE_MARKET_DATA_CACHE_SECONDS=300
UNISWAP_QUOTE_CACHE_SECONDS=15

# NOTE: Protocol addresses (Aave, Uniswap, tokens, Chainlink feeds) are in
#       config/chains.js and config/priceFeeds.js — not here.
