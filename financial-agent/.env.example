# Service
NODE_ENV=development
PORT=3003
HOST="127.0.0.1"
CORS_ORIGINS="http://127.0.0.1:5173,http://localhost:5173"

# AI
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
AGENT_MAX_TOOL_ITERATIONS=8

# Shared infrastructure
DATABASE_URL="postgresql://aa_wallet:aa_wallet@localhost:5432/aa_wallet?schema=public"
REDIS_URL="redis://localhost:6379"
BACKEND_API_URL="http://127.0.0.1:3001"

# Arbitrum Sepolia
ARBITRUM_SEPOLIA_RPC_URL="https://sepolia-rollup.arbitrum.io/rpc"
ARBITRUM_SEPOLIA_BUNDLER_URL=""

# Runtime limits and cache lifetimes
TRANSACTION_PROPOSAL_TTL_SECONDS=300
CHAINLINK_MAX_PRICE_AGE_SECONDS=3600
AAVE_MARKET_DATA_CACHE_SECONDS=300
UNISWAP_QUOTE_CACHE_SECONDS=15
