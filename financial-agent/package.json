{
  "name": "financial-agent",
  "version": "1.0.0",
  "description": "Isolated Financial Intelligence Agent for AA Smart Wallet platform",
  "main": "server.js",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "db:generate": "prisma generate --schema=./prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=./prisma/schema.prisma --name",
    "db:push": "prisma db push --schema=./prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.4",
    "express": "^4.21.1",
    "groq-sdk": "^0.7.0",
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
