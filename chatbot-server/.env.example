# Token-wei per 1 ETH-wei exchange rate for the gas token.
# Formula: (token_price_per_eth * 10^token_decimals)
# Example: 1 ETH = 2000 USDC (6 decimals) → 2000 * 1e6 = 2000000000
GAS_TOKEN_ETH_RATE="2000000000"
