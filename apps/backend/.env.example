# Service
PORT=3001
HOST="127.0.0.1"
CORS_ORIGINS="http://127.0.0.1:5173,http://localhost:5173"
RATE_LIMIT_MAX=0
RATE_LIMIT_WINDOW_MS=60000

# Persistence
DATABASE_URL="postgresql://aa_wallet:aa_wallet@localhost:5432/aa_wallet?schema=public"
REDIS_URL="redis://localhost:6379"

# UserOperation reconciliation and indexing
USEROP_RECEIPT_WORKER_ENABLED=true
USEROP_RECEIPT_POLL_INTERVAL_MS=15000
USEROP_RECEIPT_BATCH_SIZE=25
USEROP_RECEIPT_STALE_MINUTES=20
USEROP_RECEIPT_FALLBACK_BLOCKS=150
USEROP_INDEXER_ENABLED=true
USEROP_INDEXER_POLL_INTERVAL_MS=30000
USEROP_INDEXER_CONFIRMATIONS=2
USEROP_INDEXER_BLOCK_RANGE=150
USEROP_INDEXER_START_LOOKBACK_BLOCKS=300

# Browser-public Arbitrum Sepolia configuration returned by GET /config
PUBLIC_ARBITRUM_SEPOLIA_RPC_URL="https://sepolia-rollup.arbitrum.io/rpc"
PUBLIC_ARBITRUM_SEPOLIA_BUNDLER_URL=""
PUBLIC_ARBITRUM_SEPOLIA_EXPLORER_URL="https://sepolia.arbiscan.io"

# Shared public contract addresses
ENTRY_POINT=""
CREATE3_FACTORY=""
FACTORY=""
OLD_EOA_FACTORY=""
NEXUS_IMPLEMENTATION=""
NEXUS_BOOTSTRAP=""
K1_VALIDATOR=""
SESSION_KEY_VALIDATOR=""
SOCIAL_RECOVERY_VALIDATOR=""
WEBAUTHN_VALIDATOR=""
WEBAUTHN_VALIDATOR_OLD=""

# Arbitrum Sepolia public protocol contracts
PAYMASTER=""
USDC_TOKEN=""
WETH_TOKEN=""
ARBITRUM_SEPOLIA_PRICE_FEED=""
AAVE_YIELD_POOL=""
UNISWAP_ROUTER=""
UNISWAP_QUOTER=""
MULTISIG_PROXY=""
