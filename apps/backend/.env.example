PORT=3001
HOST="127.0.0.1"
DATABASE_URL="postgresql://aa_wallet:aa_wallet@localhost:5432/aa_wallet?schema=public"
REDIS_URL="redis://localhost:6379"

# Backend-owned UserOperation receipt reconciliation.
USEROP_RECEIPT_WORKER_ENABLED=true
USEROP_RECEIPT_POLL_INTERVAL_MS=15000
USEROP_RECEIPT_BATCH_SIZE=25
USEROP_RECEIPT_STALE_MINUTES=20
USEROP_RECEIPT_FALLBACK_BLOCKS=150

# Browser-public RPC URLs returned by GET /config.
PUBLIC_SEPOLIA_RPC_URL="https://rpc.sepolia.org"
PUBLIC_AMOY_RPC_URL="https://rpc-amoy.polygon.technology/"

# Browser-public bundler URLs.
PUBLIC_SEPOLIA_BUNDLER_URL=""
PUBLIC_AMOY_BUNDLER_URL=""

# Shared contracts. These are public addresses, never private keys.
ENTRY_POINT=""
CREATE3_FACTORY=""
FACTORY=""
OLD_EOA_FACTORY=""
NEXUS_IMPLEMENTATION=""
NEXUS_BOOTSTRAP=""
K1_VALIDATOR=""
SESSION_KEY_VALIDATOR=""
SOCIAL_RECOVERY_VALIDATOR=""
WEBAUTHN_VALIDATOR=""
WEBAUTHN_VALIDATOR_OLD=""

# Per-chain public contracts.
PAYMASTER=""
USDC_TOKEN=""
PRICE_FEED=""
MOCK_AGGREGATOR=""
MULTISIG_PROXY=""
