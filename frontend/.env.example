# ========================================================
# Nexus Multi-Chain Smart Account Environment Configuration
# ========================================================

# --------------------------------------------------------
# 1. RPC & Network Setup
# --------------------------------------------------------
# The chain ID where the UI will connect (e.g. 11155111 for Sepolia, 80002 for Amoy)
VITE_CHAIN_ID=""
# Standard RPC URL for Sepolia
VITE_SEPOLIA_RPC_URL=""
# Standard RPC URL for Polygon Amoy
VITE_AMOY_RPC_URL=""
# Bundler URL for ERC-4337 operations on Sepolia (Etherspot Skandha)
VITE_SKANDHA_RPC_URL=""
# Bundler URL for ERC-4337 operations on Amoy (Pimlico)
VITE_PIMLICO_BUNDLER_URL=""

# --------------------------------------------------------
# 2. Wallet & Private Keys
# --------------------------------------------------------
# WARNING: Do not use these in production! These are for testnet deployment and setup only.
# The primary private key for deployment and EOA ownership
VITE_PRIVATE_KEY=""
# Private keys for Guardians used in the Social Recovery module
VITE_GUARDIAN_1_PK=""
VITE_GUARDIAN_2_PK=""
VITE_GUARDIAN_3_PK=""

# --------------------------------------------------------
# 3. Nexus Infrastructure (Deterministic across chains)
# --------------------------------------------------------
# Addresses should be exactly the same across all EVM chains because of CREATE3 deployments.
# Standard ERC-4337 EntryPoint v0.7
VITE_ENTRY_POINT="0x0000000071727De22E5E9d8BAf0edAc6f37da032"
# Universal CREATE3 Factory (used to guarantee identical contract addresses)
VITE_CREATE3FACTORY="0xb31fd259D799Fa4AdAdc64726B75E6195D635C59"
# K1ValidatorFactory (The main Smart Account factory used in the App)
VITE_FACTORY="0x17249378E661929b73277c9E5B815716b9bb2D1B"
# The core Nexus implementation proxy contract
VITE_NEXUS_IMPLEMENTATION="0xD44bB5500FF30B30Ea2488ca3Df9c27bb76A4498"
# Bootstrapper contract to configure Nexus modularity upon initialization
VITE_NEXUS_BOOTSTRAP="0x88727A0b41e236459476235119A219e9872A0d19"

# --------------------------------------------------------
# 4. Modular Validators
# --------------------------------------------------------
# The default ECDSA Validator module
VITE_K1_VALIDATOR="0x6e003A2a991ebad2978666A74C5b1AfeA4D3fB3c"
# Module handling session keys (temporary permissioned access)
VITE_SESSION_KEY_VALIDATOR="0xa5d0847AEb41866EcFEB8BAF0c9163566aD9E373"
# Module handling social recovery (guardian-based access recovery)
VITE_SOCIAL_RECOVERY_VALIDATOR="0xcc9bA7b65f6E5468608F7803Edbab5348Cd3A9Ff"
# Module handling Passkey / WebAuthn validation (FaceID, TouchID, Yubikey)
VITE_WEBAUTHN_VALIDATOR="0xe89c5d5468Cd3F6d700C7Aaed3Ae3a867C6944cE"

# --------------------------------------------------------
# 5. Paymaster & Tokens
# --------------------------------------------------------
# ERC20 Paymaster contract used to sponsor gas in exchange for ERC20 tokens
VITE_PAYMASTER="0x7d045fA2F7DE36fB537852442bb2693D2a6b5Aa3"
# Testnet USDC Token address (used to pay gas)
VITE_USDC_TOKEN="0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238"
# Chainlink Native/USD Price Feed (e.g. ETH/USD on Sepolia)
VITE_PRICE_FEED="0x694AA1769357215DE4FAC081bf1f309aDC325306"
# Custom mock aggregator for tokens missing official Chainlink feeds on testnet
VITE_MOCK_AGGREGATOR="0x2A60D7e36FC5FDa6e97aE2C7d054656382f730D7"

# --------------------------------------------------------
# 6. External APIs
# --------------------------------------------------------
# Etherspot API key for Bundler access
VITE_ETHERSPOT_API_KEY=""
# Block explorer APIs for contract verification or data fetching
VITE_ETHERSCAN_API_KEY=""
VITE_POLYGONSCAN_API_KEY=""

# --------------------------------------------------------
# 7. Application Specifics
# --------------------------------------------------------
# Demo recipient address for transfers
VITE_RECIPIENT_ADDRESS="0x8375c615DEdf492B1B2036c786EDBcfB0801c3cb"
# Example target contract for demo interactions (e.g., minting)
VITE_TARGET_CONTRACT_ADDRESS="0x67a20020C46Eb1B66f89570939b7Eb3Cf4247a9e"
# Example NFT contract address
VITE_NFT_ADDRESS="0xF2AD2C9Ce36CFC98D74B7C660f051F026f15CEd7"
